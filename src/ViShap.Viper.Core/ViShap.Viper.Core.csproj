<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <PackageId>ViShap.Viper.Core</PackageId>
        <Authors>Vahe Babayan (0xVahe)</Authors>
        <Company>ViShap Solutions</Company>
        <Copyright>Copyright © ViShap Solutions 2026</Copyright>
        <Description>Core configuration contracts and options for the Viper binary engineering ecosystem.</Description>
        <RepositoryUrl>https://github.com</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>Viper.Core</Title>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    
</Project>
