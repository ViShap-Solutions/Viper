<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

        <PackageId>ViShap.Viper.Generator</PackageId>
        <Authors>Vahe Babayan (0xVahe)</Authors>
        <Company>ViShap Solutions</Company>
        <Copyright>Copyright © ViShap Solutions 2026</Copyright>
        <Description>Build-time source generator for Viper: writes the type contracts of a BinarySerializerContext and reports contract errors as compiler diagnostics.</Description>
        <PackageTags>binary;serialization;serializer;source-generator;roslyn;schema-evolution</PackageTags>
        <RepositoryUrl>https://github.com/ViShap-Solutions/Viper</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>GENERATOR-README.md</PackageReadmeFile>
        <Title>Viper.Generator</Title>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
        <None Include="GENERATOR-README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ViShap.Viper.Generator.Tests" />
    </ItemGroup>

</Project>
